#!/bin/bash

set -o errexit -o nounset -o pipefail

destination="$1"
timestamp="$2"

# Runs inside the service state directory. Reject directory and timestamp
# inputs that could remove unrelated data or inject archive options.
[[ $destination = backup || $destination = remote-backup ]] || exit 2
[[ $timestamp =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] || exit 2
[[ -s backup-public-key.txt ]] || { echo 'Backup recipient file is required' >&2; exit 1; }

rm -rf "$destination"
mkdir "$destination"

mkdir "$destination/$timestamp"
sqlite3 attestation.db ".backup $destination/$timestamp/attestation.db"
recipient=$(cat backup-public-key.txt)
tar -cC "$destination" "$timestamp" | zstd -9 --long | age -r "$recipient" -o "$destination/$timestamp.tar.zst.age"
